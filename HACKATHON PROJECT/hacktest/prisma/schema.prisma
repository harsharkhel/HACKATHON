generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARTICIPANT
  JUDGE
  ORGANIZER
}

enum ProjectStatus {
  CREATED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LoadTestStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(PARTICIPANT)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  projects Project[]
}

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  name          String
  description   String
  projectUrl    String
  repositoryUrl String?
  status        ProjectStatus @default(CREATED)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     ProjectSession[]
  healthChecks HealthCheck[]
  loadTests    LoadTest[]
  qrSessions   QRSession[]

  @@index([userId])
  @@index([status, createdAt])
}

model ProjectSession {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  sessionToken String   @unique
  expiresAt    DateTime @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  devices DeviceSession[]

  @@index([projectId, expiresAt])
}

model DeviceSession {
  id               String   @id @default(uuid()) @db.Uuid
  projectSessionId String   @db.Uuid
  deviceType       String
  browser          String?
  operatingSystem  String?
  ipAddress        String?  @db.Inet
  userAgent        String?
  connectedAt      DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt       DateTime @default(now()) @db.Timestamptz(3)

  projectSession ProjectSession @relation(fields: [projectSessionId], references: [id], onDelete: Cascade)

  @@index([projectSessionId, lastSeenAt])
}

model HealthCheck {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @db.Uuid
  url          String
  statusCode   Int?
  responseTime Float?
  isHealthy    Boolean
  errorMessage String?
  checkedAt    DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, checkedAt])
}

model LoadTest {
  id                  String         @id @default(uuid()) @db.Uuid
  projectId           String         @db.Uuid
  targetUrl           String
  totalRequests       Int            @default(0)
  concurrentUsers     Int
  successfulRequests  Int            @default(0)
  failedRequests      Int            @default(0)
  averageResponseTime Float?
  p95ResponseTime     Float?
  p99ResponseTime     Float?
  requestsPerSecond   Float?
  startedAt           DateTime       @default(now()) @db.Timestamptz(3)
  completedAt         DateTime?      @db.Timestamptz(3)
  status              LoadTestStatus @default(QUEUED)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([status, startedAt])
}

model QRSession {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  qrToken   String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
}
