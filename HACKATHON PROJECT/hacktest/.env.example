# ===========================================
# HackTest Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ===========================================

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://hacktest:hacktest_password@localhost:5432/hacktest_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your_jwt_secret_here_change_me
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_change_me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# n8n Integration
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# Internal API (for test workers calling back)
INTERNAL_API_KEY=your_internal_api_key_here

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
