# Copy to .env for local development. Do not commit .env.
# Set a strong POSTGRES_PASSWORD before using docker-compose in any shared or production environment.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hackpreview:hackpreview@localhost:5432/hackpreview
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
ALLOW_HTTP_TARGETS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
